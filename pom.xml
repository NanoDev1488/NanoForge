<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ru.nanodev</groupId>
  <artifactId>NanoForge</artifactId>
  <version>1.0.2</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- версии тестовых зависимостей вынесены сюда, чтобы поднимать одним местом -->
    <junit.version>5.10.2</junit.version>
    <mockito.version>5.11.0</mockito.version>
    <assertj.version>3.25.3</assertj.version>
    <!-- MockBukkit версии привязаны к конкретной версии Bukkit API (v1.20 здесь) -
         при смене spigot-api ниже проверь актуальную версию на https://github.com/MockBukkit/MockBukkit -->
    <mockbukkit.version>3.9.0</mockbukkit.version>
  </properties>

  <repositories>
    <repository>
      <id>spigotmc-repo</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
    </repository>
    <repository>
      <id>sonatype</id>
      <url>https://oss.sonatype.org/content/groups/public/</url>
    </repository>
    <!-- JitPack - отсюда тянется MockBukkit -->
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Используй ту версию API, под которую собираешь: 1.16.5-R0.1-SNAPSHOT ... 1.21.1-R0.1-SNAPSHOT.
         API обратно совместим для наших целей, поэтому одна сборка спокойно работает 1.16-1.21.x -->
    <dependency>
      <groupId>org.spigotmc</groupId>
      <artifactId>spigot-api</artifactId>
      <version>1.20.4-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>

    <!-- ==================== ТЕСТОВЫЕ ЗАВИСИМОСТИ ==================== -->

    <!-- JUnit 5 (Jupiter) - основной движок тестов -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- @ParameterizedTest / @ValueSource / @CsvSource и т.д. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Mockito - мокаем Player/Plugin/CommandSender и т.д. без реального сервера -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- AssertJ - более читаемые ассерты (assertThat(...).isEqualTo(...) и т.д.) -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- MockBukkit - полноценная имитация Bukkit-сервера в памяти: можно грузить
         реальный плагин, эмулировать игроков, инвентари, события, команды и т.д.
         без поднятия настоящего Minecraft-сервера. -->
    <dependency>
      <groupId>com.github.seeseemelk</groupId>
      <artifactId>MockBukkit-v1.20</artifactId>
      <version>${mockbukkit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>NanoForge</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- явно фиксируем версию surefire, чтобы JUnit 5 гарантированно подхватился -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>

